<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bookings action -->
    <record id="action_room_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">room.booking</field>
        <field name="search_view_id" ref="view_room_booking_search"/>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <!-- Rooms action -->
    <record id="action_room_booking_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">room.booking.room</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Equipment action -->
    <record id="action_room_booking_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">room.booking.equipment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main menu -->
    <menuitem
        id="menu_room_booking_root"
        name="Room Booking"
        sequence="10"
    />

    <!-- Bookings -->
    <menuitem
        id="menu_room_booking_bookings"
        name="Bookings"
        parent="menu_room_booking_root"
        action="action_room_booking"
        sequence="10"
    />

    <!-- Configuration -->
    <menuitem
        id="menu_room_booking_configuration"
        name="Configuration"
        parent="menu_room_booking_root"
        sequence="90"
    />

    <!-- Rooms -->
    <menuitem
        id="menu_room_booking_rooms"
        name="Rooms"
        parent="menu_room_booking_configuration"
        action="action_room_booking_room"
        sequence="10"
    />

    <!-- Equipment -->
    <menuitem
        id="menu_room_booking_equipment"
        name="Equipment"
        parent="menu_room_booking_configuration"
        action="action_room_booking_equipment"
        sequence="20"
    />

</odoo>
