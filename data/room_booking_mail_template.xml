<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="mail_template_room_booking_reminder" model="mail.template">
        <field name="name">Room Booking: Reminder</field>
        <field name="model_id" ref="model_room_booking"/>
        <field name="subject">Reminder: {{ object.name }}</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">{{ object.organizer_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.organizer_id.name or 'there'"/>,</p>

                <p>
                    This is a reminder for your upcoming room booking:
                </p>

                <ul>
                    <li>
                        <strong>Subject:</strong>
                        <t t-out="object.name"/>
                    </li>
                    <li>
                        <strong>Room:</strong>
                        <t t-out="object.room_id.name"/>
                    </li>
                    <li>
                        <strong>Start:</strong>
                        <t t-out="object.start"/>
                    </li>
                    <li>
                        <strong>Stop:</strong>
                        <t t-out="object.stop"/>
                    </li>
                </ul>

                <p>
                    Please make sure everything is ready for the meeting.
                </p>
            </div>
        </field>
    </record>

</odoo>